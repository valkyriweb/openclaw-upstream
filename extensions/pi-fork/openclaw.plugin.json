{
  "id": "pi-fork",
  "name": "Pi Fork",
  "description": "Routes OpenClaw agent turns through the Pi coding-agent RPC runtime.",
  "providers": ["pi-fork"],
  "syntheticAuthRefs": ["pi-fork"],
  "activation": {
    "onStartup": false,
    "onAgentHarnesses": ["pi-fork"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": { "type": "string" },
      "args": {
        "type": "array",
        "items": { "type": "string" },
        "default": []
      },
      "turnTimeoutMs": {
        "type": "number",
        "minimum": 1,
        "default": 300000
      },
      "downstreamProvider": { "type": "string" },
      "downstreamProvidersByModel": {
        "type": "object",
        "additionalProperties": { "type": "string" },
        "default": {}
      },
      "promptContextMode": {
        "type": "string",
        "enum": ["full", "lean-automation"],
        "default": "full"
      },
      "leanPromptTriggers": {
        "type": "array",
        "items": { "type": "string", "enum": ["heartbeat", "cron"] }
      },
      "compactionTriggerTokens": {
        "type": "number",
        "minimum": 1
      },
      "piMonoForkSource": { "type": "string" },
      "defaultThinkingLevel": {
        "type": "string",
        "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "adaptive"],
        "default": "off"
      },
      "piMonoForkRef": { "type": "string" },
      "piMonoForkRuntimeDir": { "type": "string" },
      "piMonoForkAutoInstall": {
        "type": "boolean",
        "default": true
      },
      "myPiHarnessPackagePath": { "type": "string" },
      "authProfilesPath": { "type": "string" },
      "piAuthPath": { "type": "string" },
      "piAgentDir": { "type": "string" },
      "nativeToolExclude": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["Agent"]
      },
      "nativeToolEager": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["TaskBackgroundList", "TaskStop"]
      },
      "adaptorTools": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "server", "tool"],
          "properties": {
            "name": { "type": "string" },
            "server": { "type": "string" },
            "tool": { "type": "string" },
            "description": { "type": "string" },
            "label": { "type": "string" },
            "inputSchema": { "type": "object" }
          }
        }
      },
      "adaptorExec": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } }
        }
      },
      "adaptorTimeoutMs": {
        "type": "number",
        "minimum": 1
      }
    }
  }
}
