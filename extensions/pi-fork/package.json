{
  "name": "@openclaw/pi-fork",
  "version": "0.1.0",
  "description": "OpenClaw agent harness plugin that routes turns through the Pi coding-agent RPC runtime",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.5.9-beta.1",
      "minGatewayVersion": "2026.5.9-beta.1"
    },
    "build": {
      "openclawVersion": "2026.5.9-beta.1"
    },
    "release": {
      "publishToClawHub": false,
      "publishToNpm": false
    }
  },
  "dependencies": {
    "openclaw": "workspace:*"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  }
}
